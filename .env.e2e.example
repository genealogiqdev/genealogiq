# Copy to `.env.e2e` (gitignored) and fill in the Neon `development` branch.
# Playwright loads this and forces it onto the app dev server, so e2e NEVER
# touches production.

# REQUIRED — the Neon `development` branch pooled connection string.
DATABASE_URL=

# REQUIRED — reuse the same AUTH_SECRET your BMS app uses locally.
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3000

# Optional placeholders so the app boots without external services in e2e.
BLOB_READ_WRITE_TOKEN=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
EMAIL=e2e-admin@genealogiq.test
PASSWORD=e2e-Password-123!
