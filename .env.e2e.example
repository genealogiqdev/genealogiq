# Copy to `.env.e2e` (gitignored) only for a verified disposable local/test DB.
# This legacy harness does not enforce DB locality or isolate provider calls.
# Follow docs/TESTING.md; use the local launcher for public smoke.

# REQUIRED — explicit disposable local DB; the seed requires an existing schema.
DATABASE_URL=postgresql://genealogiq:genealogiq@127.0.0.1:5432/genealogiq

# REQUIRED — reuse the same AUTH_SECRET your BMS app uses locally.
AUTH_SECRET=
AUTH_TRUST_HOST=true
AUTH_URL=http://localhost:3001

# Optional placeholders so the app boots without external services in e2e.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_MEDIA_CONTAINER=media
AZURE_STORAGE_STAGING_CONTAINER=media-staging
AZURE_STORAGE_MIGRATION_CONTAINER=media-migration
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:10000/devstoreaccount1/media
NEXT_PUBLIC_MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:10000/devstoreaccount1/media
RESEND_API_KEY=
STRIPE_SECRET_KEY=
EMAIL=local-admin@genealogiq.test
PASSWORD=Local-Password-123!
