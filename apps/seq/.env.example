# urls
APP_URL="https://genealogiq.app"
BMS_URL="https://bms.genealogiq.app"
SEQUOIA_URL="https://sequoia.rip"

# host
AUTH_TRUST_HOST=true

# prisma
DATABASE_URL=
# Maximum PostgreSQL connections per application replica.
DATABASE_POOL_MAX=5

# auth
# AUTH_URL is intentionally unset in dev, AUTH_TRUST_HOST=true handles port flexibility.
# In production set AUTH_URL=https://sequoia.rip
AUTH_URL=
AUTH_SECRET=

# google oauth ("Sign in with Google") — https://console.cloud.google.com/apis/credentials
# Alternate credential for an already-invited staff User only — Google never
# self-registers new Sequoia staff. Missing either value disables the provider
# entirely (Credentials-only, no behavior change).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure Blob media. UseDevelopmentStorage=true targets the Azurite service in compose.yaml.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_MEDIA_CONTAINER=media
AZURE_STORAGE_STAGING_CONTAINER=media-staging
AZURE_STORAGE_MIGRATION_CONTAINER=media-migration
AZURE_STORAGE_MANAGED_IDENTITY_CLIENT_ID=
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:10000/devstoreaccount1/media
NEXT_PUBLIC_MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:10000/devstoreaccount1/media

# resend
RESEND_API_KEY=

# stripe (QR Package one-time checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# sentry (observability) — provisioned by a human in sentry.io; never commit real values.
# NEXT_PUBLIC_SENTRY_DSN is per-app (public by design). SENTRY_AUTH_TOKEN/ORG/PROJECT
# are set in the Vercel project env for source-map upload at build time (no-op without them).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
