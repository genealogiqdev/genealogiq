{
  "expo": {
    "name": "Genealogiq",
    "slug": "genealogiq",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "genealogiq",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.genealogiq.mobile",
      "associatedDomains": [
        "applinks:genealogiq.com.br",
        "applinks:www.genealogiq.com.br",
        "applinks:sequoia.genealogiq.com.br",
        "applinks:bms.genealogiq.com.br"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "br.com.genealogiq.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#616198"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "genealogiq.com.br",
              "pathPrefix": "/qr/"
            },
            {
              "scheme": "https",
              "host": "genealogiq.com.br",
              "pathPrefix": "/profile/"
            },
            {
              "scheme": "https",
              "host": "genealogiq.com.br",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "genealogiq.com.br",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "genealogiq.com.br",
              "pathPrefix": "/subscriptions"
            },
            {
              "scheme": "https",
              "host": "sequoia.genealogiq.com.br",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "bms.genealogiq.com.br",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "sequoia.genealogiq.com.br",
              "pathPrefix": "/verify-email"
            },
            {
              "scheme": "https",
              "host": "bms.genealogiq.com.br",
              "pathPrefix": "/verify-email"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      "expo-font",
      "expo-image",
      "expo-web-browser",
      "expo-sharing",
      "expo-video",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#D1DBE5",
          "dark": {
            "backgroundColor": "#232339"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Genealogiq uses the camera to scan memorial QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Genealogiq needs access to your photos to add them to profiles and galleries.",
          "cameraPermission": "Genealogiq uses the camera to take photos for profiles and galleries."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Genealogiq uses your location to fill in the coordinates of a place."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Genealogiq saves QR code images to your photos.",
          "savePhotosPermission": "Genealogiq saves QR code images to your photos."
        }
      ],
      "expo-notifications",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "owner": "rnsbrum",
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "6e2bae57-9241-4e54-a908-393384f39dc2"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/6e2bae57-9241-4e54-a908-393384f39dc2"
    }
  }
}
