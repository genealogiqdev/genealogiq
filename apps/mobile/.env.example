# Backends the mobile app talks to. Leave unset to use the defaults:
# development -> the three local apps (http://localhost:3000/3001/3002, or
# 10.0.2.2 on the Android emulator); release -> the production hosts.
# A physical phone needs the development machine's LAN address here.
EXPO_PUBLIC_APP_URL=
EXPO_PUBLIC_BMS_URL=
EXPO_PUBLIC_SEQUOIA_URL=
