# urls
APP_URL="https://genealogiq.app"
BMS_URL="https://bms.genealogiq.app"
SEQUOIA_URL="https://sequoia.rip"

# host
AUTH_TRUST_HOST=true

# prisma (shared Neon Postgres — same DATABASE_URL across the 3 apps)
DATABASE_URL=
# Maximum PostgreSQL connections per application replica.
DATABASE_POOL_MAX=5

# auth
# AUTH_URL is intentionally unset in dev, AUTH_TRUST_HOST=true handles port flexibility.
# In production set AUTH_URL=https://genealogiq.app
AUTH_URL=
AUTH_SECRET=

# google oauth ("Sign in with Google") — https://console.cloud.google.com/apis/credentials
# Missing either value disables the provider entirely (Credentials-only, no behavior change).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Azure Blob media. UseDevelopmentStorage=true targets the Azurite service in compose.yaml.
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_STORAGE_ACCOUNT_NAME=
AZURE_STORAGE_ACCOUNT_URL=
AZURE_STORAGE_MEDIA_CONTAINER=media
AZURE_STORAGE_STAGING_CONTAINER=media-staging
AZURE_STORAGE_MIGRATION_CONTAINER=media-migration
AZURE_STORAGE_MANAGED_IDENTITY_CLIENT_ID=
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:10000/devstoreaccount1/media
NEXT_PUBLIC_MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:10000/devstoreaccount1/media

# resend
RESEND_API_KEY=

# stripe (subscription checkout + webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# sentry (observability) — provisioned by a human in sentry.io; never commit real values.
# NEXT_PUBLIC_SENTRY_DSN is per-app (public by design). SENTRY_AUTH_TOKEN/ORG/PROJECT
# are set in the build environment for optional source-map upload (no-op without them).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# web push (VAPID) — generate once with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is public by design (client subscribe key).
# Missing values disable push gracefully (no-op with a single warn log).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# cloudflare turnstile (footer bug/contact/career forms) — free, create a site at
# https://dash.cloudflare.com/?to=/:account/turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is public by design (client widget key).
# Missing TURNSTILE_SECRET_KEY disables server-side verification gracefully
# (no-op with a single warn log) — do not ship prod without a real secret.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional kill switch for the external WikiTree search integration.
ENABLE_WIKITREE_SEARCH=true
