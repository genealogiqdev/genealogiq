# urls
APP_URL="https://genealogiq.app"
BMS_URL="https://bms.genealogiq.app"
SEQUOIA_URL="https://sequoia.rip"

# host
AUTH_TRUST_HOST=true

# prisma
DATABASE_URL=
# Maximum PostgreSQL connections per application replica.
DATABASE_POOL_MAX=5

# auth
# AUTH_URL is intentionally unset in dev, AUTH_TRUST_HOST=true handles port flexibility.
# In production set AUTH_URL=https://bms.genealogiq.app
AUTH_URL=
AUTH_SECRET=

# google oauth ("Sign in with Google") — https://console.cloud.google.com/apis/credentials
# Alternate credential for an already-invited staff User only — Google never
# self-registers new BMS staff. Missing either value disables the provider
# entirely (Credentials-only, no behavior change).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# vercel blob
BLOB_READ_WRITE_TOKEN=

# resend
RESEND_API_KEY=

# stripe — BMS both writes (Product/Price/Coupon sync) and now receives.
# STRIPE_WEBHOOK_SECRET is the signing secret of the BMS destination alone
# (bms.genealogiq.app/api/stripe/webhook); SEQ and APP have their own, and the
# three are different values.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# sentry (observability) — provisioned by a human in sentry.io; never commit real values.
# NEXT_PUBLIC_SENTRY_DSN is per-app (public by design). SENTRY_AUTH_TOKEN/ORG/PROJECT
# are set in the Vercel project env for source-map upload at build time (no-op without them).
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Bearer secret used by the daily Azure Container Apps scheduled job.
CRON_SECRET=
