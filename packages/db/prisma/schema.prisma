model GenCode {
  id                  String              @id @default(cuid())
  genCode             String              @unique @map("gen_code")
  status              GenCodeStatus       @default(AVAILABLE)
  tenantId            String              @map("tenant_id")
  /// Which cycle minted this code. Provenance only — it is NEVER the gate.
  /// The old model gated activation on the originating Sale's window, which is
  /// precisely what made rollover impossible: a code minted in cycle 1 died
  /// with cycle 1. Authorisation now comes from the credit ledger.
  mintedInCycleId     String?             @map("minted_in_cycle_id")
  /// Which one-time package order minted this virtual code.
  mintedInOrderId     String?             @map("minted_in_order_id")
  /// The CONSUME that paid for this activation. Set with activatedAt, never before.
  creditTransactionId String?             @unique @map("credit_transaction_id")
  appUserId           String?             @unique @map("app_user_id")
  activatedAt         DateTime?           @map("activated_at")
  printedAt           DateTime?           @map("printed_at")
  // Write-off ("baixa"): a code is SOLD before it is ACTIVATED by the consumer.
  soldAt              DateTime?           @map("sold_at")
  soldVia             GenCodeSaleChannel? @map("sold_via")
  soldById            String?             @map("sold_by_id")
  soldToAppUserId     String?             @map("sold_to_app_user_id")
  soldToName          String?             @map("sold_to_name")
  soldValue           Decimal?            @map("sold_value") @db.Decimal(10, 2)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @default(now()) @updatedAt @map("updated_at")
  appUser             AppUser?            @relation("GenCodeMemorial", fields: [appUserId], references: [id])
  soldToAppUser       AppUser?            @relation("GenCodeBuyer", fields: [soldToAppUserId], references: [id])
  soldBy              User?               @relation(fields: [soldById], references: [id])
  tenant              Tenant              @relation(fields: [tenantId], references: [id])
  mintedInCycle       SubscriptionCycle?  @relation(fields: [mintedInCycleId], references: [id])
  mintedInOrder       GenCodeOrder?       @relation("OrderGenCodes", fields: [mintedInOrderId], references: [id], onDelete: SetNull)
  creditTransaction   CreditTransaction?  @relation("ConsumedBy", fields: [creditTransactionId], references: [id])
  reservation         CreditReservation?
  committedGrant      CreditGrant?        @relation("CommittedFor")

  @@index([tenantId, status])
  @@index([mintedInOrderId])
  @@map("gencodes")
}

// ─── One-time virtual GenCode packages ───────────────────────────────────────

/// The BMS catalogue entry for demand-based virtual GenCode purchases.
///
/// It is deliberately separate from PartnerPlan: this is a one-time BRL price,
/// while a PartnerPlan is a recurring annual contract with rollover rules.
model GenCodePackage {
  id                      String           @id @default(cuid())
  code                    String           @unique
  name                    String
  unitPrice               Decimal          @map("unit_price") @db.Decimal(10, 2)
  currency                String           @default("BRL") @db.VarChar(3)
  minimumQuantity         Int              @default(20) @map("minimum_quantity")
  activationTrialMonths   Int              @default(12) @map("activation_trial_months")
  activationTrialPlanCode String?          @default("PREMIUM") @map("activation_trial_plan_code")
  isActive                Boolean          @default(true) @map("is_active")
  stripeProductId         String?          @unique @map("stripe_product_id")
  stripePriceId           String?          @unique @map("stripe_price_id")
  createdAt               DateTime         @default(now()) @map("created_at")
  updatedAt               DateTime         @updatedAt @map("updated_at")
  orders                  GenCodeOrder[]
  coupons                 DiscountCoupon[] @relation("CouponGenCodePackages")

  @@map("gencode_packages")
}

/// One operator-created, one-time package checkout.
///
/// Price fields are snapshots: changing the catalogue later must never rewrite
/// what this customer was charged. Fulfilment is linked to both the ledger grant
/// and every virtual code it minted, so a paid order is fully auditable.
model GenCodeOrder {
  id                      String               @id @default(cuid())
  packageId               String               @map("package_id")
  tenantId                String               @map("tenant_id")
  partnerSubscriptionId   String?              @map("partner_subscription_id")
  discountCouponId        String?              @map("discount_coupon_id")
  discountCode            String?              @map("discount_code") @db.VarChar(32)
  createdById             String?              @map("created_by_id")
  creditGrantId           String?              @unique @map("credit_grant_id")
  status                  GenCodeOrderStatus   @default(PENDING)
  quantity                Int
  currency                String               @db.VarChar(3)
  unitPrice               Decimal              @map("unit_price") @db.Decimal(10, 2)
  discountAmount          Decimal              @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount             Decimal              @map("total_amount") @db.Decimal(12, 2)
  activationTrialMonths   Int                  @default(12) @map("activation_trial_months")
  activationTrialPlanCode String?              @default("PREMIUM") @map("activation_trial_plan_code")
  stripeCheckoutSessionId String?              @unique @map("stripe_checkout_session_id")
  stripePaymentIntentId   String?              @unique @map("stripe_payment_intent_id")
  checkoutExpiresAt       DateTime?            @map("checkout_expires_at")
  paidAt                  DateTime?            @map("paid_at")
  creditExpiresAt         DateTime?            @map("credit_expires_at")
  failedAt                DateTime?            @map("failed_at")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  package                 GenCodePackage       @relation(fields: [packageId], references: [id], onDelete: Restrict)
  tenant                  Tenant               @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  partnerSubscription     PartnerSubscription? @relation(fields: [partnerSubscriptionId], references: [id], onDelete: SetNull)
  discountCoupon          DiscountCoupon?      @relation(fields: [discountCouponId], references: [id], onDelete: SetNull)
  createdBy               User?                @relation(fields: [createdById], references: [id], onDelete: SetNull)
  creditGrant             CreditGrant?         @relation("OrderGrant", fields: [creditGrantId], references: [id], onDelete: SetNull)
  genCodes                GenCode[]            @relation("OrderGenCodes")
  couponRedemption        CouponRedemption?

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([partnerSubscriptionId])
  @@index([discountCouponId])
  @@index([status, createdAt(sort: Desc)])
  @@map("gencode_orders")
}

// ─── Partner plans, cycles & versioned price book ────────────────────────────
//
// The recurring B2B product is a yearly contract that grants the RIGHT to
// activate a number of codes. Standalone GenCode packages stay separate above
// so they do not inherit cycle opening, renewal or rollover behaviour.

/// A commercial plan a partner subscribes to — Semente, Raízes, Árvore, Floresta.
///
/// Every knob the founder listed as "must be configurable" lives here as a
/// column rather than a constant, and `version` lets a plan's terms change
/// without rewriting the contracts already signed under the old ones: a cycle
/// snapshots the terms it opened with (see SubscriptionCycle.planSnapshot).
model PartnerPlan {
  id                         String                @id @default(cuid())
  name                       String
  code                       String                @unique
  description                String?
  /// Activations included in one annual cycle.
  annualAllowance            Int                   @map("annual_allowance")
  /// Share of the RENEWED plan's allowance that unused credits may carry over.
  /// Floored to whole units at renewal — see the rollover algorithm.
  rolloverRate               Decimal               @default(0.30) @map("rollover_rate") @db.Decimal(4, 3)
  rolloverValidityMonths     Int                   @default(6) @map("rollover_validity_months")
  /// Days after a cycle ends in which paying still renews AND preserves rollover.
  graceDays                  Int                   @default(30) @map("grace_days")
  /// How long a credit committed to an identified buyer outlives its cycle.
  /// This is what keeps a family who already paid the partner from losing
  /// the plaque when the partner walks away. 12 months is a starting guess —
  /// nobody has measured the sale-to-activation lag yet.
  committedReservationMonths Int                   @default(12) @map("committed_reservation_months")
  /// The B2C trial an activation hands the guardian. 0 = no trial.
  activationTrialMonths      Int                   @default(12) @map("activation_trial_months")
  /// Which Subscription.code that trial grants. Null = no trial regardless of
  /// the months above.
  activationTrialPlanCode    String?               @map("activation_trial_plan_code")
  isActive                   Boolean               @default(true) @map("is_active")
  version                    Int                   @default(1)
  createdAt                  DateTime              @default(now()) @map("created_at")
  updatedAt                  DateTime              @updatedAt @map("updated_at")
  prices                     PlanPrice[]
  subscriptions              PartnerSubscription[]
  cycles                     SubscriptionCycle[]
  coupons                    DiscountCoupon[]      @relation("CouponPlans")

  @@map("partner_plans")
}

/// One price, for one product, in one currency, valid for one window.
///
/// Serves BOTH sides of the business: a PartnerPlan (B2B) or a Subscription
/// (B2C). Exactly one of the two FKs is set — enforced by a CHECK constraint in
/// the migration, because the alternative (a polymorphic owner id with no FK)
/// gives up the integrity that makes a price book worth trusting.
///
/// Prices are VERSIONED, never edited in place. `Package.priceBrl` was a mutable
/// column, so changing a price silently rewrote the revenue history of every
/// sale that carried no amount snapshot — queries/reports.ts documents that
/// scar. Here a change closes the current row and opens a new one, so a contract
/// can always resolve the price that was in force when it was signed.
model PlanPrice {
  id                       String        @id @default(cuid())
  partnerPlanId            String?       @map("partner_plan_id")
  subscriptionId           String?       @map("subscription_id")
  currency                 String        @db.VarChar(3)
  /// ISO-3166-1 alpha-2, or null for "wherever this currency is the fallback".
  /// Country picks the catalogue a buyer sees; currency picks what Stripe
  /// charges. Not the same question: MXN is priced for Mexico, while USD is the
  /// fallback everywhere we have no local book.
  countryScope             String?       @map("country_scope") @db.VarChar(2)
  /// The whole annual cycle, paid at once.
  annualCashAmount         Decimal       @map("annual_cash_amount") @db.Decimal(10, 2)
  /// Instalments for that same cycle. Both null = cash only. Deliberately NOT
  /// derived from annualCashAmount: the 12x carries a 20% surcharge, and
  /// deriving it would erase a commercial decision.
  installmentCount         Int?          @map("installment_count")
  installmentAmount        Decimal?      @map("installment_amount") @db.Decimal(10, 2)
  /// Published "cost per activation" reference. Stored rather than computed,
  /// because the rounding in it is a commercial choice, not arithmetic.
  unitReferenceAmount      Decimal?      @map("unit_reference_amount") @db.Decimal(10, 2)
  effectiveFrom            DateTime      @map("effective_from")
  /// Null = still in force. Set when a newer version supersedes this row.
  effectiveTo              DateTime?     @map("effective_to")
  version                  Int           @default(1)
  isActive                 Boolean       @default(true) @map("is_active")
  stripeProductId          String?       @map("stripe_product_id")
  stripeCashPriceId        String?       @unique @map("stripe_cash_price_id")
  stripeInstallmentPriceId String?       @unique @map("stripe_installment_price_id")
  createdAt                DateTime      @default(now()) @map("created_at")
  updatedAt                DateTime      @updatedAt @map("updated_at")
  partnerPlan              PartnerPlan?  @relation(fields: [partnerPlanId], references: [id], onDelete: Cascade)
  subscription             Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([partnerPlanId, currency, effectiveFrom])
  @@index([subscriptionId, currency, effectiveFrom])
  @@map("plan_prices")
}

/// A partner's standing contract. Owns identity and billing; the franchise and
/// the dates belong to the CYCLE, because those are what renewal replaces.
model PartnerSubscription {
  id                      String                    @id @default(cuid())
  tenantId                String                    @map("tenant_id")
  planId                  String                    @map("plan_id")
  status                  PartnerSubscriptionStatus @default(PENDING)
  autoRenew               Boolean                   @default(true) @map("auto_renew")
  /// The launch guarantee: 100% of unused credits carried once, instead of the
  /// standard cap. `used` is the latch that keeps "once" honest.
  founderRolloverEligible Boolean                   @default(false) @map("founder_rollover_eligible")
  founderRolloverUsed     Boolean                   @default(false) @map("founder_rollover_used")
  currentCycleId          String?                   @unique @map("current_cycle_id")
  stripeSubscriptionId    String?                   @unique @map("stripe_subscription_id")
  stripeCustomerId        String?                   @map("stripe_customer_id")
  createdAt               DateTime                  @default(now()) @map("created_at")
  updatedAt               DateTime                  @updatedAt @map("updated_at")
  tenant                  Tenant                    @relation(fields: [tenantId], references: [id])
  plan                    PartnerPlan               @relation(fields: [planId], references: [id])
  currentCycle            SubscriptionCycle?        @relation("CurrentCycle", fields: [currentCycleId], references: [id])
  cycles                  SubscriptionCycle[]       @relation("SubscriptionCycles")
  grants                  CreditGrant[]
  genCodeOrders           GenCodeOrder[]

  @@index([tenantId])
  @@index([status])
  @@map("partner_subscriptions")
}

/// One paid period of a contract. Renewal closes one and opens the next.
///
/// The snapshots are the point: a cycle must keep answering "what did this
/// partner actually agree to" long after the plan's terms and the price book
/// have moved on (RF-14). Stored as JSON rather than copied columns because
/// they are read as a unit, never queried field-by-field, and freezing the
/// whole shape survives later columns being added to PartnerPlan.
model SubscriptionCycle {
  id                 String                  @id @default(cuid())
  subscriptionId     String                  @map("subscription_id")
  planId             String                  @map("plan_id")
  planSnapshot       Json                    @map("plan_snapshot")
  priceSnapshot      Json                    @map("price_snapshot")
  startAt            DateTime                @map("start_at")
  endAt              DateTime                @map("end_at")
  /// endAt + plan.graceDays, frozen so a later change to the plan cannot move
  /// a deadline a partner is already living under.
  graceEndAt         DateTime                @map("grace_end_at")
  status             SubscriptionCycleStatus @default(ACTIVE)
  /// The cycle this one renewed from. Unique: a cycle can only be renewed once.
  renewedFromCycleId String?                 @unique @map("renewed_from_cycle_id")
  /// Stripe invoice that opened this cycle — the idempotency key for renewal.
  stripeInvoiceId    String?                 @unique @map("stripe_invoice_id")
  createdAt          DateTime                @default(now()) @map("created_at")
  updatedAt          DateTime                @updatedAt @map("updated_at")
  subscription       PartnerSubscription     @relation("SubscriptionCycles", fields: [subscriptionId], references: [id], onDelete: Cascade)
  plan               PartnerPlan             @relation(fields: [planId], references: [id])
  renewedFrom        SubscriptionCycle?      @relation("CycleRenewal", fields: [renewedFromCycleId], references: [id])
  renewedInto        SubscriptionCycle?      @relation("CycleRenewal")
  currentOf          PartnerSubscription?    @relation("CurrentCycle")
  genCodes           GenCode[]
  grants             CreditGrant[]
  couponRedemption   CouponRedemption?

  @@index([subscriptionId, startAt(sort: Desc)])
  @@index([endAt])
  @@map("subscription_cycles")
}

// ─── Credit ledger ───────────────────────────────────────────────────────────
//
// The right to activate, made explicit. A cycle grants credits; selling a code
// reserves one; activating it consumes one. Nothing else may move a balance.
//
// The ledger is the source of truth. `CreditGrant.remainingQty` exists so a
// balance can be read without folding the whole history every time, but it is a
// materialisation: if the two ever disagree, the transactions win and the
// counter is the thing that is wrong.

/// A batch of rights, with one origin and one expiry.
///
/// Splitting credits into grants rather than a single counter is what makes
/// FEFO possible at all: rollover expires in six months and the fresh annual
/// allowance in twelve, so "which credit did this activation spend" has to have
/// an answer.
model CreditGrant {
  id                 String               @id @default(cuid())
  tenantId           String               @map("tenant_id")
  subscriptionId     String?              @map("subscription_id")
  /// The cycle that opened this grant. Null for COMMITTED grants, which
  /// deliberately outlive whichever cycle funded them.
  cycleId            String?              @map("cycle_id")
  source             CreditSource
  grantedQty         Int                  @map("granted_qty")
  /// Materialised balance — see the note above. Never read without a lock in a
  /// path that also writes.
  remainingQty       Int                  @map("remaining_qty")
  /// Null = no expiry. Only ever true for grants that predate the model.
  expiresAt          DateTime?            @map("expires_at")
  /// 0 for a fresh allowance, 1 for credits that have already rolled once.
  /// A grant with generation > 0 can never roll again — that is the rule that
  /// stops credits living forever by rolling repeatedly.
  rolloverGeneration Int                  @default(0) @map("rollover_generation")
  status             CreditGrantStatus    @default(ACTIVE)
  /// Set only on COMMITTED grants: the code and the buyer this unit belongs to.
  /// A committed unit is out of the general pool and cannot be spent on anything
  /// else, which is the whole point — the family already paid for it.
  genCodeId          String?              @unique @map("gen_code_id")
  buyerId            String?              @map("buyer_id")
  createdById        String?              @map("created_by_id")
  reason             String?
  createdAt          DateTime             @default(now()) @map("created_at")
  updatedAt          DateTime             @updatedAt @map("updated_at")
  tenant             Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription       PartnerSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  cycle              SubscriptionCycle?   @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  genCode            GenCode?             @relation("CommittedFor", fields: [genCodeId], references: [id])
  buyer              AppUser?             @relation(fields: [buyerId], references: [id])
  transactions       CreditTransaction[]
  reservations       CreditReservation[]
  genCodeOrder       GenCodeOrder?        @relation("OrderGrant")

  // The FEFO index: live grants for one tenant, soonest to expire first.
  @@index([tenantId, status, expiresAt])
  @@index([cycleId])
  @@map("credit_grants")
}

/// The immutable razão. Every movement of every balance lands here, once.
///
/// `idempotencyKey` is what makes "once" true across webhook replays and double
/// submits: the caller names the operation, and a repeat loses to the unique
/// index instead of moving the balance twice.
model CreditTransaction {
  id              String                @id @default(cuid())
  grantId         String                @map("grant_id")
  tenantId        String                @map("tenant_id")
  type            CreditTransactionType
  /// Always positive. The type says which direction it moves.
  quantity        Int
  /// The grant's remaining balance immediately after this row was written —
  /// what makes the ledger auditable without replaying it from the beginning.
  balanceAfter    Int                   @map("balance_after")
  genCodeId       String?               @map("gen_code_id")
  reservationId   String?               @map("reservation_id")
  idempotencyKey  String                @unique @map("idempotency_key")
  occurredAt      DateTime              @default(now()) @map("occurred_at")
  actorId         String?               @map("actor_id")
  reason          String?
  grant           CreditGrant           @relation(fields: [grantId], references: [id], onDelete: Cascade)
  consumedGenCode GenCode?              @relation("ConsumedBy")

  @@index([tenantId, occurredAt(sort: Desc)])
  @@index([grantId])
  @@map("credit_transactions")
}

/// A credit held for a specific code between the partner selling it and the
/// family activating it.
///
/// Always points at the grant that will actually pay: the origin grant for a
/// manual write-off, a dedicated COMMITTED grant for a platform sale. That is
/// the difference the founder decided on — a sale with an identified buyer
/// survives the cycle expiring, a name typed into a box does not.
model CreditReservation {
  id                String                  @id @default(cuid())
  tenantId          String                  @map("tenant_id")
  grantId           String                  @map("grant_id")
  genCodeId         String                  @unique @map("gen_code_id")
  quantity          Int                     @default(1)
  status            CreditReservationStatus @default(HELD)
  /// Mirrors the backing grant's expiry, so the two cannot drift apart.
  expiresAt         DateTime?               @map("expires_at")
  externalReference String?                 @map("external_reference")
  idempotencyKey    String                  @unique @map("idempotency_key")
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")
  grant             CreditGrant             @relation(fields: [grantId], references: [id], onDelete: Cascade)
  genCode           GenCode                 @relation(fields: [genCodeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@map("credit_reservations")
}
