// @genealogiq/db — single source of truth for the Prisma schema shared by
// BMS, SEQ and APP. All three apps point their Prisma client at this package.
//
// This schema was derived by introspecting the live Neon database (`prisma db
// pull`) — the only representation that exactly matches production — and then
// renaming Prisma's auto-generated identifiers back to the apps' conventions so
// existing code keeps compiling. Structural attributes (column types, legacy
// constraint names via `map:`, partial indexes, referential actions) are kept
// verbatim from the introspection. See docs/PHASE-4-DB-CONSOLIDATION.md.
//
// Acceptance gate: `prisma migrate diff --from-schema-datamodel
// prisma/schema.prisma --to-url $DATABASE_URL` must report no difference.

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  OWNER
  ADMIN
  COMERCIAL
  FINANCE
  USER
}

enum AppRole {
  APP_USER
  APP_MEMO
  APP_GHOST
  APP_PET
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum EmailTokenType {
  VERIFICATION
  CHANGE
}

enum TributeStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EntityType {
  INDIVIDUAL
  COMPANY
}

enum PartnerSegment {
  FUNERAL_HOME
  MARBLE_SHOP
  CEMETERY
  URN_MANUFACTURER
  PLAQUE_PRINTER
}

enum GenCodeStatus {
  AVAILABLE
  SOLD
  ACTIVATED
}

enum GenCodeSaleChannel {
  PLATFORM
  MANUAL
}

enum GuardianStatus {
  PENDING
  ACCEPTED
}

enum QrStatus {
  PENDING
  PRINTED
  INSTALLED
}

enum NotificationType {
  TRIBUTE_PENDING
  TRIBUTE_APPROVED
  TRIBUTE_REJECTED
  FAMILY_REQUEST_PENDING
  FAMILY_REQUEST_ACCEPTED
  FAMILY_REQUEST_REJECTED
  GUARDIAN_REQUEST_PENDING
  GUARDIAN_REQUEST_ACCEPTED
  GUARDIAN_REQUEST_REJECTED
}

enum CreditSource {
  ANNUAL
  ROLLOVER
  FOUNDER_ROLLOVER
  COMMITTED
  BONUS
  TOPUP
  MIGRATION
}

enum CreditTransactionType {
  GRANT
  RESERVE
  RELEASE
  CONSUME
  EXPIRE
  ADJUST
  REVERSE
}

enum CreditGrantStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
}

enum CreditReservationStatus {
  HELD
  CONSUMED
  RELEASED
  EXPIRED
}

enum PartnerSubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  EXPIRED
  CANCELLED
}

enum SubscriptionCycleStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum GenCodeOrderStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
}

// ─── Subscriptions, Packages & Sales ─────────────────────────────────────────

model Subscription {
  id             String      @id @default(cuid())
  name           String
  description    String?
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")
  // How many months one term covers. Feeds every cash Price's interval_count,
  // and 0 means a non-recurring ("lifetime") plan that cannot be synced.
  termLength     Int         @map("term_length")
  code           String      @unique
  // Prices moved to PlanPrice — the same versioned book the partner plans use.
  // They lived here as mutable per-currency columns, which meant editing an
  // amount rewrote what every past sale had been charged. See `prices` below.
  // Quota numbers previously hardcoded in the APP's plan-quotas.ts — moved
  // here so BMS can edit every plan attribute manually, without a code
  // deploy. Defaults mirror the FREE plan's current numbers.
  treeMaxMembers Int         @default(32) @map("tree_max_members")
  bioMaxChars    Int         @default(2048) @map("bio_max_chars")
  // Combined pool: Bio images + Gallery images + GeoPlace photos.
  mediaMaxImages Int         @default(32) @map("media_max_images")
  mediaMaxVideos Int         @default(8) @map("media_max_videos")
  documentsMax   Int         @default(16) @map("documents_max")
  // Row count of GeoPlace — independent of mediaMaxImages.
  geoPlacesMax   Int         @default(3) @map("geo_places_max")
  // How many memorial profiles a guardian may create in total. The only
  // memorial cap since the per-sale bulk-slot binding was removed.
  memorialsMax   Int         @default(1) @map("memorials_max")
  petsMax        Int         @default(0) @map("pets_max")
  // Free QR codes (own profile + guarded memorials, combined).
  qrCodeMax      Int         @default(1) @map("qr_code_max")
  appSales       AppSale[]
  coupons        DiscountCoupon[] @relation("CouponSubscriptions")
  // Versioned price book (see PlanPrice). Coexists with the price_* columns
  // above during the cutover: the columns are still the ones the APP reads.
  prices         PlanPrice[]

  @@map("subscriptions")
}

model DiscountCoupon {
  id                    String           @id @default(cuid())
  code                  String           @unique
  description           String?
  discountType          String           @map("discount_type")
  /// Exactly one of these two shapes is populated, per discountType.
  /// A percentage has no currency and stays a single number; a fixed amount is
  /// money, so it needs one slot per currency like every other price here.
  percentOff            Decimal?         @map("percent_off") @db.Decimal(10, 2)
  amountOffUsd          Decimal?         @map("amount_off_usd") @db.Decimal(10, 2)
  amountOffBrl          Decimal?         @map("amount_off_brl") @db.Decimal(10, 2)
  amountOffMxn          Decimal?         @map("amount_off_mxn") @db.Decimal(10, 2)
  duration              String
  /// Manual coupons settle a single sale in BMS after an external payment or stock reconciliation.
  redemptionMode        String           @default("stripe") @map("redemption_mode")
  durationInMonths      Int?             @map("duration_in_months")
  maxRedemptions        Int?             @map("max_redemptions")
  redeemBy              DateTime?        @map("redeem_by")
  stripeCouponId        String?          @unique @map("stripe_coupon_id")
  stripePromotionCodeId String?          @unique @map("stripe_promotion_code_id")
  createdById           String           @map("created_by_id")
  isActive              Boolean          @default(true) @map("is_active")
  createdAt             DateTime         @default(now()) @map("created_at")
  updatedAt             DateTime         @updatedAt @map("updated_at")
  appliesTo             PartnerPlan[]    @relation("CouponPlans")
  genCodePackages       GenCodePackage[] @relation("CouponGenCodePackages")
  subscriptions         Subscription[]   @relation("CouponSubscriptions")
  genCodeOrders         GenCodeOrder[]
  redemptions           CouponRedemption[]

  @@map("discount_coupons")
}

model AppSale {
  id                   String       @id @default(cuid())
  value                Decimal?     @db.Decimal(10, 2)
  appUserId            String       @map("app_user_id")
  subscriptionId       String       @map("subscription_id")
  tenantId             String?      @map("tenant_id")
  soldById             String?      @map("sold_by_id")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  stripeSubscriptionId String?      @unique @map("stripe_subscription_id")
  stripePriceId        String?      @map("stripe_price_id")
  // Captured directly from the real Stripe Price's currency on the webhook
  // (never re-derived from the buyer's locale) — a Stripe subscription can't
  // change currency mid-life, so this is the source of truth for which of
  // Subscription's per-currency price columns applies to this sale. Null for
  // legacy/SEQ-vendor sales that never touched Stripe.
  currency             String?
  cadence              String?
  status               String?
  currentPeriodEnd     DateTime?    @map("current_period_end")
  cancelAtPeriodEnd    Boolean      @default(false) @map("cancel_at_period_end")
  canceledAt           DateTime?    @map("canceled_at")
  endedAt              DateTime?    @map("ended_at")
  appUser              AppUser      @relation("AppSaleBuyer", fields: [appUserId], references: [id], onDelete: Cascade)
  soldBy               User?        @relation(fields: [soldById], references: [id], onDelete: Restrict)
  subscription         Subscription @relation(fields: [subscriptionId], references: [id])
  tenant               Tenant?      @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  couponRedemption     CouponRedemption?
  consumerAccessGrant  ConsumerAccessGrant?

  @@index([appUserId])
  @@map("app_sales")
}

/// A complimentary 12-month Premium release by Genealogiq. Permanent identities
/// retain the audit and request deduplication after consumer/sale deletion.
model ConsumerAccessGrant {
  id            String   @id @default(cuid())
  requestId     String   @unique @map("request_id")
  requestHash   String   @map("request_hash")
  recipientId   String   @map("recipient_id")
  resultId      String   @unique @map("result_id")
  appUserId     String?  @map("app_user_id")
  appSaleId     String?  @unique @map("app_sale_id")
  createdById   String   @map("created_by_id")
  startsAt      DateTime @map("starts_at")
  expiresAt     DateTime @map("expires_at")
  notes         String?  @db.VarChar(500)
  emailSentAt   DateTime? @map("email_sent_at")
  revokedAt     DateTime? @map("revoked_at")
  revokedById   String?   @map("revoked_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  appUser       AppUser? @relation(fields: [appUserId], references: [id], onDelete: SetNull)
  appSale       AppSale? @relation(fields: [appSaleId], references: [id], onDelete: SetNull)

  @@index([recipientId, expiresAt])
  @@index([appUserId, createdAt(sort: Desc)])
  @@map("consumer_access_grants")
}

/// Immutable evidence of one BMS-authorized, fully discounted sale. The result
/// and this record are committed together; request and receipt keys prevent
/// retries or a second operator from granting the same sale twice.
model CouponRedemption {
  id                  String   @id @default(cuid())
  requestId           String   @unique @map("request_id")
  requestHash         String   @map("request_hash")
  /// Permanent result identity survives deletion of a consumer account/sale.
  resultId            String   @unique @map("result_id")
  couponId            String   @map("coupon_id")
  code                String
  kind                String
  recipientId         String   @map("recipient_id")
  productId           String   @map("product_id")
  quantity            Int
  cadence             String?
  source              String
  reference           String   @db.VarChar(160)
  externalAmount      Decimal? @map("external_amount") @db.Decimal(12, 2)
  currency            String   @db.VarChar(3)
  subtotalAmount      Decimal  @map("subtotal_amount") @db.Decimal(12, 2)
  discountAmount      Decimal  @map("discount_amount") @db.Decimal(12, 2)
  totalAmount         Decimal  @map("total_amount") @db.Decimal(12, 2)
  createdById         String   @map("created_by_id")
  createdAt           DateTime @default(now()) @map("created_at")
  genCodeOrderId      String?  @unique @map("gencode_order_id")
  subscriptionCycleId String?  @unique @map("subscription_cycle_id")
  appSaleId           String?  @unique @map("app_sale_id")
  coupon              DiscountCoupon    @relation(fields: [couponId], references: [id], onDelete: Restrict)
  genCodeOrder        GenCodeOrder?     @relation(fields: [genCodeOrderId], references: [id], onDelete: Restrict)
  subscriptionCycle  SubscriptionCycle? @relation(fields: [subscriptionCycleId], references: [id], onDelete: Restrict)
  appSale             AppSale?          @relation(fields: [appSaleId], references: [id], onDelete: SetNull)

  @@unique([source, reference])
  @@index([couponId, createdAt(sort: Desc)])
  @@index([recipientId])
  @@map("coupon_redemptions")
}

model StripeEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stripe_events")
}

// Durable, non-secret transactional notifications. Never store passwords or
// setup/reset tokens here; those use their existing expiring-token flow.
model EmailOutbox {
  id              String    @id
  recipient       String
  message         Json
  context         Json?
  attempts        Int       @default(0)
  availableAt     DateTime  @default(now()) @map("available_at")
  processingUntil DateTime? @map("processing_until")
  claimToken      String?   @map("claim_token")
  sentAt          DateTime? @map("sent_at")
  canceledAt      DateTime? @map("canceled_at")
  expiresAt       DateTime? @map("expires_at")
  lastError       String?   @map("last_error")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([sentAt, canceledAt, availableAt], map: "email_outbox_pending")
  @@map("email_outbox")
}

// One-time "buy 1 extra unit" purchases (geo places / QR codes / memorial
// slots) on top of a guardian's plan quota — independent of the recurring
// Subscription pricing above. resource/tier are free-text ("GEO_PLACE" |
// "QR_CODE" | "MEMORIAL", "FREE" | "PREMIUM") rather than enums, mirroring
// Subscription.code's own free-text convention.
model ExtraUnitPrice {
  id               String   @id @default(cuid())
  resource         String
  tier             String
  priceUsd         Decimal? @map("price_usd") @db.Decimal(10, 2)
  priceBrl         Decimal? @map("price_brl") @db.Decimal(10, 2)
  priceMxn         Decimal? @map("price_mxn") @db.Decimal(10, 2)
  stripeProductId  String?  @unique @map("stripe_product_id")
  stripePriceIdUsd String?  @unique @map("stripe_price_id_usd")
  stripePriceIdBrl String?  @unique @map("stripe_price_id_brl")
  stripePriceIdMxn String?  @unique @map("stripe_price_id_mxn")

  @@unique([resource, tier])
  @@map("app_extra_unit_prices")
}

model ExtraUnitPurchase {
  id              String   @id @default(cuid())
  buyerId         String   @map("buyer_id")
  resource        String
  quantity        Int      @default(1)
  // Buyer's tier at purchase time — audit only, not read back for quota math.
  tier            String
  currency        String
  amountPaid      Decimal  @map("amount_paid") @db.Decimal(10, 2)
  stripeSessionId String?  @unique @map("stripe_session_id")
  createdAt       DateTime @default(now()) @map("created_at")
  buyer           AppUser  @relation(fields: [buyerId], references: [id])

  @@index([buyerId, resource])
  @@map("app_extra_unit_purchases")
}

// ─── Auth tokens & rate limiting ─────────────────────────────────────────────

model RateLimitAttempt {
  id          Int      @id @default(autoincrement())
  key         String
  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@index([key, attemptedAt])
  @@index([attemptedAt])
  @@map("rate_limit_attempts")
}

model EmailToken {
  id        String         @id @default(cuid())
  token     String         @unique
  type      EmailTokenType
  userId    String?        @map("user_id")
  newEmail  String?        @map("new_email")
  expiresAt DateTime       @map("expires_at")
  createdAt DateTime       @default(now()) @map("created_at")
  appUserId String?        @map("app_user_id") @db.VarChar
  appUser   AppUser?       @relation(fields: [appUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User?          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String?  @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  appUserId String?  @map("app_user_id") @db.VarChar
  appUser   AppUser? @relation(fields: [appUserId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── Address & Company ───────────────────────────────────────────────────────

model Address {
  id           String    @id @default(cuid())
  zip          String?
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  country      String?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  appUser      AppUser?
  company      Company?
  supplier     Supplier?
  tenant       Tenant?
  user         User?

  @@map("addresses")
}

model Company {
  id                    String   @id @default(cuid())
  legalName             String   @map("legal_name")
  tradeName             String   @map("trade_name")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  taxId                 String   @unique @map("tax_id")
  email                 String   @unique
  phone                 String
  phoneCountryCode      String   @default("55") @map("phone_country_code")
  stateRegistration     String?  @map("state_registration")
  municipalRegistration String?  @map("municipal_registration")
  isActive              Boolean  @default(true) @map("is_active")
  addressId             String?  @unique @map("address_id")
  address               Address? @relation(fields: [addressId], references: [id])

  @@map("companies")
}

// ─── User (BMS/SEQ operators only) ───────────────────────────────────────────

model User {
  id                   String               @id @default(cuid())
  firstName            String               @map("first_name")
  lastName             String               @map("last_name")
  email                String               @unique
  password             String?
  role                 Role                 @default(USER)
  isActive             Boolean              @default(true) @map("is_active")
  emailVerified        DateTime?            @map("email_verified")
  failedLoginAttempts  Int                  @default(0) @map("failed_login_attempts")
  lockedUntil          DateTime?            @map("locked_until")
  // Bookkeeping only — never the sign-in lookup key. Google sign-in resolves
  // the row by verified email, matching Credentials' identity model.
  googleId             String?              @unique(map: "users_google_id_unique", where: raw("(google_id IS NOT NULL)")) @map("google_id")
  createdAt            DateTime             @default(now()) @map("created_at")
  updatedAt            DateTime             @updatedAt @map("updated_at")
  nationalId           String?              @map("national_id")
  birthDate            DateTime?            @map("birth_date")
  phoneCountryCode     String               @default("55") @map("phone_country_code")
  phone                String?
  addressId            String?              @unique @map("address_id")
  tenantId             String?              @map("tenant_id")
  birth_place          String?
  birth_country        String?
  death_date           DateTime?
  death_place          String?
  death_country        String?
  avatarUrl            String?              @map("avatar_url")
  cover_url            String?
  gender               String?              @map("gender") @db.VarChar(10)
  appSales             AppSale[]
  createdAppUserCats   AppUserCategory[]    @relation("app_user_categories_created_by_idTousers")
  updatedAppUserCats   AppUserCategory[]    @relation("app_user_categories_updated_by_idTousers")
  createdAppUsers      AppUser[]            @relation("app_users_created_by_idTousers")
  updatedAppUsers      AppUser[]            @relation("app_users_updated_by_idTousers")
  emailTokens          EmailToken[]
  passwordResetTokens  PasswordResetToken[]
  genCodesSold         GenCode[]
  genCodeOrdersCreated GenCodeOrder[]
  createdSupplierCats  SupplierCategory[]   @relation("supplier_categories_created_by_idTousers")
  updatedSupplierCats  SupplierCategory[]   @relation("supplier_categories_updated_by_idTousers")
  createdSuppliers     Supplier[]           @relation("suppliers_created_by_idTousers")
  updatedSuppliers     Supplier[]           @relation("suppliers_updated_by_idTousers")
  address              Address?             @relation(fields: [addressId], references: [id])
  tenant               Tenant?              @relation(fields: [tenantId], references: [id], map: "users_customer_id_fkey")

  @@index([tenantId])
  @@map("users")
}

// ─── AppUser (deceased memorials + APP login users) ──────────────────────────

model AppUser {
  id                        String               @id @default(cuid())
  firstName                 String               @map("first_name")
  lastName                  String               @map("last_name")
  gender                    Gender?
  birthDate                 DateTime?            @map("birth_date")
  birthCity                 String?              @map("birth_city")
  birthState                String?              @map("birth_state")
  birthCountry              String?              @map("birth_country")
  email                     String?              @unique(map: "app_users_email_unique", where: raw("(email IS NOT NULL)"))
  phoneCountryCode          String               @default("55") @map("phone_country_code")
  phone                     String?
  notes                     String?
  isActive                  Boolean              @default(true) @map("is_active")
  // Opt-OUT public-visibility toggle for living users (role=APP_USER). Ignored
  // for APP_MEMO (already public via role alone) and APP_GHOST (never publicly
  // reachable regardless of this value — see assertPublicMemorialAccess).
  isPublicProfile           Boolean              @default(true) @map("is_public_profile")
  fb                        String?
  instagram                 String?
  linkedin                  String?
  tiktok                    String?
  x                         String?
  youtube                   String?
  website                   String?
  tenantId                  String?              @map("tenant_id")
  categoryId                String?              @map("category_id")
  addressId                 String?              @unique @map("address_id")
  createdAt                 DateTime             @default(now()) @map("created_at")
  updatedAt                 DateTime             @updatedAt @map("updated_at")
  createdById               String?              @map("created_by_id")
  otherSocial               String?              @map("other_social")
  updatedById               String?              @map("updated_by_id")
  role                      AppRole              @default(APP_USER)
  birthPlace                String?              @map("birth_place") @db.VarChar
  avatarUrl                 String?              @map("avatar_url") @db.VarChar
  nationalId                String?              @map("national_id") @db.VarChar
  deathDate                 DateTime?            @map("death_date")
  deathPlace                String?              @map("death_place") @db.VarChar
  deathCountry              String?              @map("death_country") @db.VarChar
  password                  String?              @db.VarChar
  emailVerified             DateTime?            @map("email_verified")
  failedLoginAttempts       Int                  @default(0) @map("failed_login_attempts")
  lockedUntil               DateTime?            @map("locked_until")
  // Bookkeeping only — never the sign-in lookup key. Google sign-in resolves
  // the row by verified email, matching Credentials' identity model.
  googleId                  String?              @unique(map: "app_users_google_id_unique", where: raw("(google_id IS NOT NULL)")) @map("google_id")
  deathCause                String?              @map("death_cause") @db.VarChar
  deathState                String?              @map("death_state") @db.VarChar
  maidenName                String?              @map("maiden_name")
  nickname                  String?
  stripeCustomerId          String?              @unique @map("stripe_customer_id")
  preferredLocale           String?              @map("preferred_locale")
  // Only meaningful for role=APP_PET — same nullable-role-specific-field
  // pattern already used above for death*/auth-only columns.
  petSpecies                String?              @map("pet_species")
  petBreed                  String?              @map("pet_breed")
  bio                       Bio?
  familyFrom                FamilyRelation[]     @relation("FamilyFrom")
  familyTo                  FamilyRelation[]     @relation("FamilyTo")
  petOwnerships             PetOwnership[]       @relation("PetProfile")
  petsOwned                 PetOwnership[]       @relation("PetOwner")
  favoritesReceived         Favorite[]           @relation("FavoriteTarget")
  favoritesGiven            Favorite[]           @relation("FavoriteUser")
  galleryItems              GalleryItem[]
  geolocation               Geolocation?
  geoPlaces                 GeoPlace[]
  documents                 Document[]
  actorNotifications        Notification[]       @relation("ActorNotifications")
  notifications             Notification[]       @relation("UserNotifications")
  appSales                  AppSale[]            @relation("AppSaleBuyer")
  consumerAccessGrants      ConsumerAccessGrant[]
  tributesAuthored          Tribute[]            @relation("TributeAuthor")
  tributesReceived          Tribute[]            @relation("TributeProfile")
  guardianRequestsMade      AppUserGuardian[]    @relation("GuardianRequestedBy")
  guardedBy                 AppUserGuardian[]    @relation("GuardedBy")
  guardiansOf               AppUserGuardian[]    @relation("GuardianOf")
  address                   Address?             @relation(fields: [addressId], references: [id])
  category                  AppUserCategory?     @relation(fields: [categoryId], references: [id])
  createdBy                 User?                @relation("app_users_created_by_idTousers", fields: [createdById], references: [id])
  tenant                    Tenant?              @relation("AppUserTenant", fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy                 User?                @relation("app_users_updated_by_idTousers", fields: [updatedById], references: [id])
  emailTokens               EmailToken[]
  passwordResetTokens       PasswordResetToken[]
  genCode                   GenCode?             @relation("GenCodeMemorial")
  genCodesBought            GenCode[]            @relation("GenCodeBuyer")
  pushSubscriptions         PushSubscription[]
  qrCode                    QrCode?
  treeNodePositionsAsRoot   TreeNodePosition[]   @relation("TreeNodePositionRoot")
  treeNodePositionsAsPerson TreeNodePosition[]   @relation("TreeNodePositionPerson")
  extraUnitPurchases        ExtraUnitPurchase[]
  committedCredits          CreditGrant[]

