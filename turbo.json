{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "DATABASE_POOL_MAX",
    "AUTH_SECRET",
    "AUTH_URL",
    "AUTH_TRUST_HOST",
    "APP_URL",
    "BMS_URL",
    "SEQUOIA_URL",
    "RESEND_API_KEY",
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "MEDIA_PUBLIC_BASE_URL",
    "NEXT_PUBLIC_MEDIA_PUBLIC_BASE_URL",
    "AZURE_STORAGE_CONNECTION_STRING",
    "AZURE_STORAGE_ACCOUNT_NAME",
    "AZURE_STORAGE_ACCOUNT_URL",
    "AZURE_STORAGE_MEDIA_CONTAINER",
    "AZURE_STORAGE_STAGING_CONTAINER",
    "AZURE_STORAGE_MIGRATION_CONTAINER",
    "AZURE_STORAGE_MANAGED_IDENTITY_CLIENT_ID",
    "CRON_SECRET",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "TURNSTILE_SECRET_KEY",
    "ENABLE_WIKITREE_SEARCH",
    "GOOGLE_CLIENT_ID",
    "GOOGLE_CLIENT_SECRET",
    "NEXT_PUBLIC_SENTRY_DSN",
    "NEXT_PUBLIC_VAPID_PUBLIC_KEY",
    "NEXT_PUBLIC_TURNSTILE_SITE_KEY",
    "SENTRY_ORG",
    "SENTRY_PROJECT",
    "SENTRY_AUTH_TOKEN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate", "db:generate"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": ["^db:generate", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^db:generate", "db:generate"]
    },
    "db:generate": {
      "cache": false
    }
  }
}
